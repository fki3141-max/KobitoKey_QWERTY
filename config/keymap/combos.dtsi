/*
 * コンボ設定
 *   キー位置の名前は keymap/kobito.h の図を参照（数字で書いてもOK）。
 *
 *   COMBO  (名前, キー位置, バインディング)
 *   COMBO_T(名前, キー位置, バインディング, タイムアウトms)
 *   COMBO_L(名前, キー位置, バインディング, 有効にするレイヤー)
 *
 *   ※ 名前は他と重複させない。キー位置はスペース区切りで2個以上。
 */

//     名前     キー位置     出力
COMBO_L( eisu,  LM3 LM4,     &kp LANG2, BASE NUM FUNC )   // D+F → 英数（MOUSE以外）
COMBO( kana,    RM2 RM3,     &kp GRAVE )   // J+K → 半角/全角（JIS の 半角/全角 キー）
COMBO( esc,     LT1 LT2,     &ht LS(ESC) ESC )   // Q+W → Esc（長押しで Shift+Esc）
COMBO( tab,     LM1 LM2,     &kp TAB   )   // A+S → Tab
COMBO( del,     LH5 RH1,     &kp DEL   )   // 左親指端+BS → Del
COMBO( at,      LM1 LH4,     &kp LBKT  )   // A+Space → @（JIS）
COMBO( bslh,    RT1 LH4,     &kp INT1  )   // Y+Space → \（JIS ろキー）
COMBO( dllr,    LM2 LH4,     &kp LS(N4))   // S+Space → $（JIS）
COMBO( colon,   RB4 RB5,     &kp APOS  )   // .+/（位置28+29）→ :（JIS）
COMBO( tabprev, LT5 LH4,     &kp LC(PG_UP) )   // T+Space（位置4+33）→ Ctrl+PageUp（前のタブ）
COMBO( tabnext, LM5 LH4,     &kp LC(PG_DN) )   // G+Space（位置14+33）→ Ctrl+PageDown（次のタブ）
COMBO( altesc,  LM2 LM3,     &ht LA(LS(ESC)) LA(ESC) )   // S+D（位置11+12）→ Alt+Esc（長押しで Alt+Shift+Esc）

// マウスレイヤーのみ
COMBO_L( rclick2, LM3 LM4,   &mkp MB2,  MOUSE )   // 12+13（D+F の位置）→ 右クリック

// CURSOR レイヤーのみ
COMBO_L( cprev, LM4 RM2,     &kp LC(PG_UP), CURSOR )   // 13+16 → Ctrl+PageUp（前のタブ）
COMBO_L( cnext, LM4 RM4,     &kp LC(PG_DN), CURSOR )   // 13+18 → Ctrl+PageDown（次のタブ）

/* ---- 書き方の例（使うときは // を外す） ----
COMBO_T( caps,  LB1 LB2,     &caps_word,    40 )        // タイムアウト40ms
COMBO_L( minus, RT4 RT5,     &kp MINUS,     BASE NUM )  // BASE と NUM のみ
COMBO(   del3,  RM2 RM3 RM4, &kp DEL )                  // 3キー同時押し
*/
