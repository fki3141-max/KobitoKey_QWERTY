/*
 * 独自ビヘイビア（マクロ・ホールドタップなど）
 *   ここで定義したものはレイヤーやコンボから &名前 で使える。
 */

/ {
    behaviors {
        /* 長押しと短押しで別のキー組み合わせを送るホールドタップ
           使い方: &ht <長押し> <短押し>   例: &ht LC(SPACE) LS(SPACE) */
        ht: hold_tap_keys {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        /* "=xlookup(" を入力するマクロ */
        m_xlookup: m_xlookup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap
                &kp EQUAL &kp X &kp L &kp O &kp O &kp K &kp U &kp P &kp LPAR>;
        };
    };
};
