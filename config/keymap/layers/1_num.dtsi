/*
 * レイヤー1: NUMBER（記号は JIS 配列に合わせている: = は LS(MINUS)、+ は LS(SEMI)）
 */
LAYER(layer1, "NUMBER",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &kp N0     &kp HOME  &kp UP    &kp END      &kp PG_UP      &kp MINUS  &kp N7     &kp N8       &kp N9  &kp N0
    &kp LS(MINUS)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN    &kp LS(SEMI)  &kp N4  &kp N5    &kp N6  &kp KP_PLUS
    &trans     &kp N7    &kp N8    &kp N9       &trans         &kp EQUAL  &kp N1     &kp N2       &kp N3  &kp RCTRL
    &trans     &trans    &trans    &key_repeat  &trans         &kp LSHFT  &kp ENTER  &mt LCTRL KP_PLUS  &trans  &trans
)
