/*
 * レイヤー1: NUMBER（記号は JIS 配列に合わせている: = は LS(MINUS)、* は LS(APOS)、^ は EQUAL）
 *   36 は短押しで Enter、長押ししている間は CURSOR レイヤー
 */
LAYER(layer1, "NUMBER",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &trans     &kp HOME  &kp UP    &kp END      &kp PG_UP      &kp LS(APOS)  &kp N7  &kp N8     &kp N9  &kp EQUAL
    &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN    &kp MINUS  &kp N4     &kp N5       &kp N6  &kp KP_PLUS
    &trans     &trans    &trans    &trans       &trans         &kp N0     &kp N1     &kp N2       &kp N3  &kp LCTRL
    &trans     &trans    &trans    &key_repeat  &trans         &mt LCTRL KP_PLUS  &lt CURSOR ENTER  &kp LSHFT  &trans  &kp SLASH
)
