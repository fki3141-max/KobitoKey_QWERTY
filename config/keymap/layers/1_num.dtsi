/*
 * レイヤー1: NUMBER（本体から読み取った内容）
 */
LAYER(layer1, "NUMBER",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &kp N0     &kp HOME  &kp UP    &kp END      &kp PG_UP      &kp MINUS  &kp N7     &kp N8       &kp N9  &kp N0
    &kp EQUAL  &kp LEFT  &kp DOWN  &kp RIGHT    &kp PG_DN      &kp PLUS   &kp N4     &kp N5       &kp N6  &kp KP_PLUS
    &trans     &kp N7    &kp N8    &kp N9       &trans         &trans     &kp N1     &kp N2       &kp N3  &kp RCTRL
    &trans     &trans    &trans    &key_repeat  &trans         &kp LSHFT  &kp ENTER  &mt LCTRL KP_PLUS  &trans  &trans
)
