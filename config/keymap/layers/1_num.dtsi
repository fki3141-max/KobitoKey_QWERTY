/*
 * レイヤー1: NUMBER（記号は JIS 配列に合わせている: = は LS(MINUS)、* は LS(APOS)、^ は EQUAL）
 */
LAYER(layer1, "NUMBER",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &kp N0     &kp HOME  &kp UP    &kp END      &kp PG_UP      &kp LS(APOS)  &kp N7  &kp N8     &kp N9  &kp EQUAL
    &kp LS(MINUS)  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN    &kp MINUS  &kp N4     &kp N5       &kp N6  &kp KP_PLUS
    &trans     &kp N7    &kp N8    &kp N9       &trans         &kp N0     &kp N1     &kp N2       &kp N3  &trans
    &trans     &trans    &trans    &key_repeat  &trans         &mt LCTRL KP_PLUS  &kp ENTER  &kp LSHFT  &trans  &kp SLASH
)
