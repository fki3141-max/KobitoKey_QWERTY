/*
 * レイヤー3: MOUSE（オートマウス）
 *   有効なのは 10=Shift、12=Win+Shift+S（画面の切り取り）、13=左クリック、16=Ctrl+PageUp（前のタブ）、18=Ctrl+PageDown（次のタブ）、34=Ctrl、38=BASEへ のみ。それ以外は無効（&none）。
 *   右クリックは 12+13 のコンボ（combos.dtsi）。
 */
LAYER(layer3, "MOUSE",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &none      &none   &none      &none     &none         &none   &none     &none     &none     &none
    &kp LSHFT  &none   &kp LG(LS(S))  &mkp MB1  &none         &none   &kp LC(PG_UP)  &none     &kp LC(PG_DN)  &none
    &none      &none   &none      &none     &none         &none   &none     &none     &none     &none
    &none      &none   &none      &none     &kp LCTRL     &none   &none     &none     &to BASE  &none
)
