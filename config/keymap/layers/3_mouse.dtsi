/*
 * レイヤー3: MOUSE（オートマウス）
 *   有効なのは 13=左クリック、20=Shift、34=Ctrl、38=BASEへ のみ。それ以外は無効（&none）。
 *   右クリックは 13+16 のコンボ（combos.dtsi）。
 */
LAYER(layer3, "MOUSE",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &none      &none   &none      &none     &none         &none   &none     &none     &none     &none
    &none      &none   &none      &mkp MB1  &none         &none   &none     &none     &none     &none
    &kp LSHFT  &none   &none      &none     &none         &none   &none     &none     &none     &none
    &none      &none   &none      &none     &kp LCTRL     &none   &none     &none     &to BASE  &none
)
