/*
 * レイヤー0: default（本体から読み取った内容）
 *   37: 短押しで 変換（INT4）、長押しで Shift
 *   &ht  = 短押し優先。170ms 以上押し続けたときだけ長押し側が出る
 *   &htl = 同上で 250ms。直前のキーから 150ms 以内なら必ず短押し（記号キー用）
 *    9: 短押しで p、長押しで ^（JIS の ^ は EQUAL）
 *   19: 短押しで -、長押しで ;
 *   20: 短押しで z、長押しで Shift
 *   29: 短押しで /、長押しで Alt（: は 28+29 のコンボ）
 */
LAYER(default_layer, "default",
//  ── 左手 ─────────────────────────────────────────    ── 右手 ─────────────────────────────────────────
    &kp Q      &kp W     &kp E     &kp R          &kp T          &kp Y     &kp U           &kp I      &kp O      &htl EQUAL P
    &kp A      &kp S     &kp D     &kp F          &kp G          &kp H     &kp J           &kp K      &kp L      &htl SEMI MINUS
    &ht LSHFT Z &kp X     &kp C     &kp V          &kp B          &kp N     &kp M           &kp COMMA  &kp DOT    &htl LALT SLASH
    &kp LCTRL  &kp LALT  &kp LCMD  &lt NUM SPACE  &kp LCTRL      &kp BSPC  &lt FUNC ENTER  &mt RSHFT INT4  &kp RSHFT  &mt LALT SLASH
)
